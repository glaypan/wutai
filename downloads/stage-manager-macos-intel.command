#!/bin/bash
# 舞台流程表 - macOS 服务器启动器
# 支持 macOS 10.14+ (Intel 和 Apple Silicon)
# 双击运行，或终端执行: bash xxx.command

set -e

echo ""
echo "=================================================="
echo "  舞台流程表 - macOS 服务器启动器"
echo "=================================================="
echo ""

ARCH=$(uname -m)
if [ "$ARCH" = "arm64" ]; then
  echo "[i] 检测到 Apple Silicon (M系列芯片)"
  NODE_ARCH="arm64"
else
  echo "[i] 检测到 Intel 处理器"
  NODE_ARCH="x64"
fi

if command -v node &> /dev/null; then
  echo "[v] Node.js 已安装: $(node --version)"
else
  echo "[!] 未检测到 Node.js，正在自动下载..."
  NODE_VERSION="v18.20.4"
  NODE_URL="https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-darwin-${NODE_ARCH}.tar.gz"
  NODE_TAR="/tmp/stage_manager_node.tar.gz"
  NODE_DIR="$HOME/.local/stage-manager-nodejs"
  echo "[+] 下载 Node.js ${NODE_VERSION} (${NODE_ARCH})..."
  curl -L --fail "$NODE_URL" -o "$NODE_TAR"
  echo "[+] 解压 Node.js ..."
  mkdir -p "$NODE_DIR"
  tar -xzf "$NODE_TAR" -C "$NODE_DIR" --strip-components=1
  export PATH="$NODE_DIR/bin:$PATH"
  echo "[v] Node.js 安装完成: $(node --version)"
fi

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_DIR="$SCRIPT_DIR/stage-manager"
mkdir -p "$APP_DIR"
cd "$APP_DIR"

echo "[+] 写入服务器文件 (共 133 段)..."
B64_FILE="$APP_DIR/server.b64"
cat > "$B64_FILE" <<'STAGE_MANAGER_B64_END'





































































































































STAGE_MANAGER_B64_END
node -e "var fs=require('fs');fs.writeFileSync(process.argv[1],Buffer.from(fs.readFileSync(process.argv[2],'utf-8'),'base64'));" server.js "$B64_FILE"
if [ $? -ne 0 ]; then
  echo "[X] 服务器文件写入失败"
  read -p "按回车键退出..."
  exit 1
fi
rm -f "$B64_FILE"
echo "[v] 服务器文件已就绪"

echo ""
echo "=================================================="
echo "  服务器正在启动..."
echo "  请记录下方显示的 IP 地址，告知其他设备"
echo "=================================================="
echo ""

node server.js

read -p "按回车键退出..."