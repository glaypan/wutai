@echo off
chcp 65001 >nul 2>&1
title 舞台流程表 - 服务器
setlocal enabledelayedexpansion

echo.
echo ==================================================
echo   舞台流程表 - Windows 服务器启动器
echo ==================================================
echo.

where node >nul 2>&1
if %errorlevel% neq 0 (
  echo [!] 未检测到 Node.js，正在自动下载...
  set "NODE_VER=v18.20.4"
  set "NODE_URL=https://nodejs.org/dist/!NODE_VER!/node-!NODE_VER!-win-x64.zip"
  set "NODE_ZIP=%TEMP%\nodejs.zip"
  set "NODE_DIR=%LOCALAPPDATA%\StageManager\nodejs"
  echo [+] 下载 Node.js !NODE_VER! ...
  curl -L -o "!NODE_ZIP!" "!NODE_URL!"
  if !errorlevel! neq 0 (
    echo [X] Node.js 下载失败，请手动安装: https://nodejs.org/
    pause
    exit /b 1
  )
  echo [+] 解压 Node.js ...
  if not exist "%LOCALAPPDATA%\StageManager" mkdir "%LOCALAPPDATA%\StageManager"
  if not exist "%TEMP%\node_extract" mkdir "%TEMP%\node_extract"
  tar -xf "!NODE_ZIP!" -C "%TEMP%\node_extract"
  if not exist "!NODE_DIR!" mkdir "!NODE_DIR!"
  xcopy /E /I /Y "%TEMP%\node_extract\node-!NODE_VER!-win-x64\*" "!NODE_DIR!" >nul 2>&1
  set "PATH=!NODE_DIR!;%PATH%"
  echo [v] Node.js 安装完成:
  "!NODE_DIR!\node.exe" --version
) else (
  echo [v] Node.js 已安装:
  node --version
)

set "APP_DIR=%~dp0stage-manager"
